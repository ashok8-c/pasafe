# -------------------------
# Server Configuration
# -------------------------
PORT=3000
JWT_SECRET=please_change_this_secret_key

# -------------------------
# MQTT Broker
# -------------------------
MQTT_BROKER=mqtt://localhost:1883

# Alcohol detection threshold (0.20 = legal limit)
ALCOHOL_THRESHOLD=0.2

# -------------------------
# Twilio SMS Notifications (Optional)
# -------------------------
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# -------------------------
# Firebase / FCM Push Notifications (Optional)
# -------------------------
FCM_SERVER_KEY=

# -------------------------
# Database (Optional future for Postgres)
# -------------------------
DATABASE_URL=sqlite://./pa_safe.db

# -------------------------
# Logging
# -------------------------
LOG_LEVEL=info
